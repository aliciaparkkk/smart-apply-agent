OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Optional default resume path (any filename; .docx or .pdf). Leave blank to upload only.
# RESUME_PATH=/path/to/My Resume.pdf

# Google — credentials.json + a Drive folder shared with the service account
GOOGLE_CREDENTIALS_PATH=credentials.json
# Folder ID from drive.google.com/drive/folders/THIS_PART (share folder with service account)
GOOGLE_DRIVE_FOLDER_ID=
# Optional: share the application log with your Google account
# GOOGLE_SHARE_EMAIL=you@gmail.com
# Optional: use an existing spreadsheet instead of auto-create
# GOOGLE_SHEET_ID=
# GOOGLE_SHEET_WORKSHEET=Applications
